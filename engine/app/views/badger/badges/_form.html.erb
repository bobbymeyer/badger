<%= its_swiss_form_with model: badge, class: "form measure" do |form| %>
  <%= render "its_swiss/shared/errors", record: badge %>

  <%= form.text_field :name, hint: "What this badge is called." %>

  <%# Tab indents rather than leaving the field: badger-document, registered
      from badger.js. Without it the document still edits; Tab just goes on. %>
  <%= form.text_area :spec_yaml, rows: 24, spellcheck: false, label: "The document",
        data: { controller: "badger-document", action: "keydown->badger-document#indent" },
        hint: "YAML. A shape, the regions it derives, type set into them, artwork, children. " \
              "Every parameter is named for what it means: band width, sweep, tracking, inset. " \
              "Fonts on this host: #{Badger::Fonts.names.join(', ').presence || 'none'}." %>

  <div class="run">
    <%= form.submit submit_label %>
    <%= link_to "Cancel", cancel_to, class: "button button--quiet" %>
  </div>
<% end %>
