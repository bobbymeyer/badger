<%# One page, three surfaces: what the badge is made of, what it wears, how
    it leaves. The drawing and what is true of it stay in the left column
    on every one, and stay put; the surface is the right. What is done daily
    is reached from the head, never by scrolling past what was done
    yesterday. The colorway the drawing wears travels with the surfaces. %>
<% sections = Badger::BadgesController::SECTIONS.map { |section|
     [ section.humanize, badge_path(@badge, section: (section unless section == "compose"), colorway: @colorway), @section == section ]
   } %>
<%= page_head @badge.name, sections: sections do %>
  <%= link_to "Edit", edit_badge_path(@badge), class: "button" %>
  <%= button_to "Take away", badge_path(@badge), method: :delete, class: "button button--danger",
        form: { data: { turbo_confirm: "Take #{@badge.name} away?" } } %>
<% end %>

<div class="preview-column stack">
  <figure class="preview-figure">
    <%= badge_preview @badge, colorway: @colorway %>
    <% if @colorway %>
      <figcaption>Wearing <%= @colorway.palette_name %>. <%= link_to "Undressed", badge_path(@badge, section: (@section unless @section == "compose")) %></figcaption>
    <% end %>
  </figure>

  <dl class="pairs">
    <dt>Slots</dt>
    <dd><%= pluralize @badge.slot_count, "colour slot" %>, ranked from the ground</dd>
    <dt>Ink</dt>
    <dd><% b = @badge.output.ink_bounds %><%= number_with_precision(b[1].x - b[0].x, precision: 1) %> by <%= number_with_precision(b[1].y - b[0].y, precision: 1) %> units</dd>
    <dt>Pieces</dt>
    <dd><%= @badge.output.pieces.size %></dd>
  </dl>

  <%= explain "Drawn in value, paper to ink. No palette is held by the badge: it is complete " \
        "without one, and a colorway is worn over it. The ink is the drawing's extent in the " \
        "document's units; the pieces are the paths it is made of." %>
</div>

<div class="detail stack">
  <%= render "badger/badges/#{@section}", badge: @badge, colorway: @colorway %>
</div>
