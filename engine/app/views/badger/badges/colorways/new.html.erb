<% content_for :title, "Dress #{@badge.name}" %>

<header class="page-head run">
  <h1>Dress <%= @badge.name %></h1>
  <%= link_to "Refresh from Pandatone", new_badge_colorway_path(@badge, refresh: 1), class: "button button--quiet" %>
</header>

<p class="lede">
  A palette with at least <%= pluralize @badge.slot_count, "colour" %>. Each is shown on the ladder,
  lightest to darkest, because what a palette is for here is its distribution of value.
</p>

<%= render "palettes", palettes: @palettes, badge: @badge %>
