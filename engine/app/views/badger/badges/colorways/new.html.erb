<%= page_head "Dress #{@badge.name}",
      lede: "#{pluralize(@badge.slot_count, "colour slot")}, ranked from the ground. A palette with at least that many colours can dress it." do %>
  <%= link_to "Back to the badge", @badge, class: "button button--quiet" %>
<% end %>

<%# The picker is Pandatone's dresser's: the catalogue, split into what can
    dress this badge and what cannot, on the ladder. %>
<%= render "pandatone/dresser/picker",
      slot_count: @badge.slot_count, serving: @serving.to_a, demoted: @demoted.to_a, unreachable: @unreachable,
      noun: "this badge",
      dress_url: ->(palette) { badge_colorways_path(@badge, palette_id: palette.id) },
      refresh_url: new_badge_colorway_path(@badge, refresh: 1) %>
