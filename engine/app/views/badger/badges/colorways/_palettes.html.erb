<% if palettes.any? %>
  <ul class="palettes">
    <% palettes.each do |palette| %>
      <li class="palette run">
        <div class="stack">
          <strong><%= palette.name %></strong>
          <%= palette_strip palette %>
        </div>
        <%= button_to "Wear #{palette.name}", badge_colorways_path(badge), params: { palette_id: palette.id }, class: "button" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="empty">Pandatone has no palette with <%= pluralize badge.slot_count, "colour" %> or more.</p>
<% end %>
