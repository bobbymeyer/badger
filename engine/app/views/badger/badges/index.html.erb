<% content_for :title, "Badges" %>
<% content_for :main_class, "grid" %>

<header class="page-head run">
  <h1>Badges</h1>
  <%= link_to "Compose a badge", new_badge_path, class: "button button--primary" %>
</header>

<% if @badges.any? %>
  <ul class="badge-cards">
    <% @badges.each do |badge| %>
      <li class="badge-card">
        <%= link_to badge_path(badge) do %>
          <%= badge_preview badge, class: "preview--card" %>
          <span class="badge-card__name"><%= badge.name %></span>
          <span class="badge-card__meta"><%= pluralize badge.slot_count, "slot" %>, <%= pluralize badge.colorways.count, "colorway" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <%= render "its_swiss/shared/pagination",
        page: @page, pages: @pages, url: ->(number) { badges_path(page: number) } %>
<% else %>
  <p class="empty">
    No badges yet. A badge is a container that derives regions, and type set into
    them: fitted, followed, or fixed. It is composed in value and carries no colour.
  </p>
<% end %>
